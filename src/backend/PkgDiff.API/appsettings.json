{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "CacheSettings": {
    "Backend": "Memory"
  },
  "Redis": {
    "InstanceName": "pkgdiff:"
  },
  "ForwardedHeaders": {
    "TrustedNetworks": "172.28.0.0/16"
  },
  "RateLimiting": {
    "General": {
      "PerMinute": 60,
      "PerFiveMinutes": 200
    },
    "PdfExport": {
      "PerMinute": 5,
      "PerFiveMinutes": 15
    },
    "Admin": {
      "PerMinute": 240,
      "PerFiveMinutes": 1200
    },
    "Login": {
      "PerMinute": 5,
      "PerFiveMinutes": 15
    },
    "AuditStart": {
      "PerMinute": 3,
      "PerFiveMinutes": 6
    }
  },
  "RateLimitSettings": {
    "NuGetScrapingMaxRequests": 45,
    "NuGetScrapingWindowSeconds": 60,
    "NuGetApiMaxRequests": 1000,
    "NuGetApiWindowSeconds": 60,
    "NpmApiMaxRequests": 500,
    "NpmApiWindowSeconds": 60,
    "GitHubScrapingMaxRequests": 30,
    "GitHubScrapingWindowSeconds": 60,
    "GitHubApiMaxRequests": 5000,
    "GitHubApiWindowSeconds": 3600,
    "GitHubApiMaxConcurrent": 50
  },
  "GitHubSettings": {
    "EnableAuthentication": true,
    "UseGitHubApi": true,
    "HtmlScrapingTimeoutSeconds": 30,
    "UserAgent": "PkgDiff/1.0"
  },
  "BackgroundJobs": {
    "CacheRefreshCron": "0 */6 * * *"
  },
  "AutoPilot": {
    "LlmModel": "qwen2:0.5b"
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434"
  }
}
