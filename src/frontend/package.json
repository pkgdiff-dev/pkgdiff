{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --poll=500",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "serve:ssr": "node dist/Frontend/server/server.mjs",
    "test": "ng test",
    "test:ssr": "node --test ssr-smoke.test.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/platform-server": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@angular/ssr": "^21.2.27",
    "@ltd/j-toml": "^1.38.0",
    "@microsoft/signalr": "^10.0.11",
    "express": "^5.3.0",
    "lucide-angular": "^0.577.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.27",
    "@angular/cli": "^21.2.27",
    "@angular/compiler-cli": "^21.2.25",
    "@tailwindcss/typography": "^0.5.20",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "autoprefixer": "^10.6.1",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "piscina": "5.3.2",
    "vite": "7.3.7",
    "@angular/build": {
      "undici": "7.30.1"
    },
    "postcss-selector-parser": "6.1.5"
  }
}
