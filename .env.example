# pkgdiff production environment template.
# Copy to /opt/pkgdiff/src/.env on the server and replace every CHANGE_ME.
# Never commit the real .env. Runbooks: docs/ops/README.md

# ---------------------------------------------------------------------------
# Images
# ---------------------------------------------------------------------------

# Required. Tag of ghcr.io/pkgdiff-dev/pkgdiff-backend and pkgdiff-frontend that docker compose runs.
# On the server deploy/deploy.sh writes this line; do not edit it by hand there.
# Use "local" together with docker-compose.build.yml to build from source.
PKGDIFF_IMAGE_TAG=local

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Required. Postgres password. Generate: openssl rand -hex 32
# Only applied when the database volume is first initialized; to change it later
# follow docs/ops/secret-rotation.md (ALTER USER + .env + recreate backend).
POSTGRES_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# Backend security
# ---------------------------------------------------------------------------

# Required. JWT signing secret, at least 32 bytes. Generate: openssl rand -base64 48
# The backend refuses to start with a shorter value or a placeholder. Changing it logs everyone out.
JWT_SECRET=CHANGE_ME

# Required. JWT issuer claim (not a secret).
JWT_ISSUER=PkgDiffAPI

# Required. JWT audience claim (not a secret).
JWT_AUDIENCE=PkgDiffClient

# Required in Production. Key that encrypts secret settings at rest: base64 of 32 random bytes.
# Generate: openssl rand -base64 32 and keep a copy in a password manager.
# Losing it makes stored secret settings unreadable (they must be re-entered in the admin UI).
SETTINGS_ENCRYPTION_KEY=CHANGE_ME

# Required only on first start, while no administrator exists: it becomes the pkgdiff_admin password.
# Once an administrator exists it is ignored (a warning is logged). Remove it from .env after the first successful start.
# Must satisfy the Identity policy: at least 8 characters with an uppercase letter, a lowercase letter and a digit.
ADMIN_PASSWORD=CHANGE_ME

# Optional. Password for the read-only viewer account; leave empty to skip seeding the viewer account.
VIEWER_PASSWORD=

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# Optional. Proxy networks whose X-Forwarded-For is trusted. Must match the compose subnet (docker-compose.yml ipam).
FORWARDED_TRUSTED_NETWORKS=172.28.0.0/16

# ---------------------------------------------------------------------------
# GitHub
# ---------------------------------------------------------------------------

# Optional. Fine-grained, read-only (public repositories) GitHub token.
# Empty = unauthenticated GitHub API calls (60 requests/hour limit).
GITHUB_PAT=

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------

# Required. Grafana admin password. Generate: openssl rand -base64 24
GRAFANA_PASSWORD=CHANGE_ME

# Optional. Loopback ports of Grafana and Prometheus, reached through an SSH tunnel
# (docs/ops/operations.md). Change them only if another program on the host uses them.
PKGDIFF_GRAFANA_PORT=3300
PKGDIFF_PROMETHEUS_PORT=9390

# ---------------------------------------------------------------------------
# Resource limits
# ---------------------------------------------------------------------------

# Optional. Memory limits of the backend and the database; the other services have fixed limits
# in docker-compose.yml. Raise them when `docker stats` shows a service close to its limit.
PKGDIFF_BACKEND_MEMORY=2g
PKGDIFF_DB_MEMORY=1024m
