<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- nuget.org only: inherited machine/user feeds must never take part in restore or audit -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
</configuration>
